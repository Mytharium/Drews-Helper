package com.drewshelper.routing;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertTrue;
import java.io.IOException;
import java.util.Collections;
import java.util.List;
import net.runelite.api.coords.WorldPoint;
import org.junit.Test;

/**
 * The Wilderness avoidance preference, and the box it depends on.
 *
 * <p>Every bound in the box was derived from the shipped transport data. Two traps were found
 * on the way and both are pinned here, because either would silently break routing to half the
 * map rather than fail loudly.
 */
public class DrewsHelperWildernessAvoidanceTest
{
    private static final WorldPoint GRAND_EXCHANGE = new WorldPoint(3185, 3508, 0);
    private static final WorldPoint INSIDE_WILDERNESS = new WorldPoint(3155, 3620, 0);
    private static final WorldPoint SOUTHERN_DESERT = new WorldPoint(3221, 2828, 0);

    @Test
    public void theBoxContainsTheWildernessAndNothingElse()
    {
        assertTrue("north of the ditch is inside",
            DrewsHelperWalkingRouteEngine.isInWilderness(new WorldPoint(3100, 3523, 0)));
        assertTrue("deep Wilderness is inside",
            DrewsHelperWalkingRouteEngine.isInWilderness(new WorldPoint(3155, 3620, 0)));

        assertFalse("south of the ditch is outside",
            DrewsHelperWalkingRouteEngine.isInWilderness(new WorldPoint(3100, 3520, 0)));
        assertFalse("the Grand Exchange is outside",
            DrewsHelperWalkingRouteEngine.isInWilderness(GRAND_EXCHANGE));
    }

    /**
     * The bands the teleport cap is compared against.
     *
     * <p>Upstream resolves these by narrowing from the deepest overlapping box down, so the
     * value is a band ceiling and not an exact level. That is all a cap of 20 needs.
     */
    @Test
    public void wildernessLevelBandsMatchUpstreamBoxes()
    {
        assertEquals("outside the Wilderness is level 0",
            0, DrewsHelperWalkingRouteEngine.wildernessLevelAt(GRAND_EXCHANGE));
        assertEquals("just north of the ditch is the 1-20 band",
            20, DrewsHelperWalkingRouteEngine.wildernessLevelAt(new WorldPoint(3136, 3525, 0)));
        assertEquals("the deep-Wilderness fixture is still inside the 1-20 band",
            20, DrewsHelperWalkingRouteEngine.wildernessLevelAt(INSIDE_WILDERNESS));
        assertEquals("past the level-20 line is the 21-30 band",
            30, DrewsHelperWalkingRouteEngine.wildernessLevelAt(new WorldPoint(3136, 3680, 0)));
        assertEquals("past the level-30 line is deeper still",
            31, DrewsHelperWalkingRouteEngine.wildernessLevelAt(new WorldPoint(3136, 3760, 0)));
        assertEquals("the underground Wilderness bands the same way",
            31, DrewsHelperWalkingRouteEngine.wildernessLevelAt(new WorldPoint(3100, 10200, 0)));
    }

    @Test
    public void instancedRegionsAboveTheWildernessAreNotInsideIt()
    {
        // Prifddinas' spirit tree destination really is (3274, 6123) - it sits in a high-y
        // instanced region, so an x-band with no ceiling would swallow it. Zanaris and the
        // dungeons are the same shape of trap.
        assertFalse("Prifddinas must not be treated as Wilderness",
            DrewsHelperWalkingRouteEngine.isInWilderness(new WorldPoint(3274, 6123, 0)));
        assertFalse("a dungeon region must not be treated as Wilderness",
            DrewsHelperWalkingRouteEngine.isInWilderness(new WorldPoint(3100, 9800, 0)));
    }

    @Test
    public void placesNorthOfTheDitchLineButOutsideTheWildernessSurvive()
    {
        // A half-plane at y >= 3522 would have blocked all of these - 7,389 of 12,388 edges.
        assertFalse("Etceteria", DrewsHelperWalkingRouteEngine.isInWilderness(new WorldPoint(2613, 3855, 0)));
        assertFalse("Hosidius", DrewsHelperWalkingRouteEngine.isInWilderness(new WorldPoint(1693, 3540, 0)));
        assertFalse("Farming Guild", DrewsHelperWalkingRouteEngine.isInWilderness(new WorldPoint(1251, 3750, 0)));
    }

    @Test
    public void aWaypointInsideTheWildernessStillRoutesWhileAvoiding() throws Exception
    {
        // The escape hatch. Switching the preference off must never strand a deliberate trip.
        List<WorldPoint> path = solve(INSIDE_WILDERNESS, true);

        int wildernessTiles = 0;
        for (WorldPoint point : path)
        {
            if (DrewsHelperWalkingRouteEngine.isInWilderness(point))
            {
                wildernessTiles++;
            }
        }

        assertTrue("a Wilderness waypoint must still be reachable", path.size() > 1);
        assertTrue("and the route must actually go there", wildernessTiles > 0);
    }

    @Test
    public void avoidingChangesNothingForARouteThatNeverEntersTheWilderness() throws Exception
    {
        // Regression net: the preference must not perturb ordinary routes.
        assertEquals(
            solve(SOUTHERN_DESERT, false).size(),
            solve(SOUTHERN_DESERT, true).size()
        );
    }

    private static List<WorldPoint> solve(WorldPoint target, boolean avoidWilderness)
        throws IOException, InterruptedException
    {
        DrewsHelperTransportGraph graph = DrewsHelperTransportGraph.loadDefault(
            DrewsHelperTransportPolicy.builder().build(),
            DrewsHelperPlayerCapability.UNRESTRICTED
        );
        DrewsHelperWalkingRouteEngine engine = new DrewsHelperWalkingRouteEngine(
            DrewsHelperCollisionMap.loadDefault(), graph, avoidWilderness);

        DrewsHelperRouteSnapshot snapshot =
            engine.solve(GRAND_EXCHANGE, Collections.singletonList(target));
        assertTrue("no route found to " + target, snapshot.hasPath());
        return snapshot.getPath();
    }
}
