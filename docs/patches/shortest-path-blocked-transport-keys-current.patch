+
+		if (value instanceof String)
+		{
+			Set<String> strings = new HashSet<>();
+			addOverrideString(strings, value);
+			return strings.isEmpty() ? Set.of() : Set.copyOf(strings);
+		}
+
+		return Set.of();
+	}
