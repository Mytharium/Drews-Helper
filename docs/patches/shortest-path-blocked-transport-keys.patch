+	public static Set<String> overrideStringSet(String configOverrideKey)
+	{
+		if (configOverride.isEmpty())
+		{
+			return Set.of();
+		}
+
+		Object value = configOverride.get(configOverrideKey);
+		if (value instanceof Collection<?>)
+		{
+			Set<String> strings = new HashSet<>();
+			for (Object item : (Collection<?>) value)
+			{
+				addOverrideString(strings, item);
+			}
+			return strings.isEmpty() ? Set.of() : Set.copyOf(strings);
+		}
+
+		if (value instanceof String)
+		{
+			Set<String> strings = new HashSet<>();
+			addOverrideString(strings, value);
+			return strings.isEmpty() ? Set.of() : Set.copyOf(strings);
+		}
+
+		return Set.of();
+	}
+
+	private static void addOverrideString(Set<String> strings, Object value)
+	{
+		if (value == null)
+		{
+			return;
+		}
+
+		String text = String.valueOf(value).trim();
+		if (!text.isEmpty())
+		{
+			strings.add(text);
+		}
+	}
