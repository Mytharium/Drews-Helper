+	private boolean isBlockedTransport(Transport transport)
+	{
+		if (blockedTransportKeys.isEmpty())
+		{
+			return false;
+		}
+
+		String key = transportKey(transport);
+		if (key.isEmpty())
+		{
+			return false;
+		}
+
+		for (String blockedKey : blockedTransportKeys)
+		{
+			if (key.equals(blockedKey) || key.startsWith(blockedKey + "_"))
+			{
+				return true;
+			}
+		}
+
+		return false;
+	}
+
+	private static String transportKey(Transport transport)
+	{
+		TransportType type = transport.getType();
+		String typeKey = type == null ? "" : slug(type.getResourcePath()
+			.replace("/transports/", "")
+			.replace(".tsv", ""));
+		if (typeKey.isEmpty())
+		{
+			return "";
+		}
+
+		String label = transport.getDisplayInfo() == null || transport.getDisplayInfo().trim().isEmpty()
+			? transport.getObjectInfo()
+			: transport.getDisplayInfo();
+		String labelKey = slug(cleanTransportLabel(label));
+		return labelKey.isEmpty() ? "" : typeKey + ":" + labelKey;
+	}
+
+	private static String cleanTransportLabel(String label)
+	{
+		if (label == null)
+		{
+			return "";
+		}
+
+		return label
+			.replaceAll("<[^>]+>", " ")
+			.replace("Minigame Teleport", "")
+			.replace("Grouping Teleport", "")
+			.replaceAll(":\\s*\\d+\\.\\s*", " ");
+	}
+
+	private static String slug(String text)
+	{
+		if (text == null)
+		{
+			return "";
+		}
+
+		return text.toLowerCase(Locale.ROOT)
+			.replace("'", "")
+			.replace("\u2019", "")
+			.replaceAll("[^a-z0-9]+", "_")
+			.replaceAll("^_+|_+$", "");
+	}
+
